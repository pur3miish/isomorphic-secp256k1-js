{
  "name": "isomorphic-secp256k1-js",
  "version": "6.0.0",
  "description": "Zero-dependency secp256k1 ECDSA for Node.js and browsers, with native or caller-supplied CSPRNG key generation, RFC 6979 signing, verification, and recovery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pur3miish/isomorphic-secp256k1-js.git"
  },
  "keywords": [
    "ECDSA",
    "bitcoin",
    "universal",
    "blockchain",
    "digital",
    "signature",
    "verification",
    "public-key-recovery",
    "key-generation",
    "private-key",
    "public-key",
    "csprng",
    "entropy",
    "randomness",
    "webcrypto",
    "web-crypto",
    "rfc6979",
    "recoverable-signature",
    "ecc",
    "elliptic",
    "curve",
    "crypto",
    "currency",
    "secp256k1",
    "browser",
    "node",
    "typescript",
    "zero-dependency",
    "lightweight"
  ],
  "author": "pur3miish",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pur3miish/isomorphic-secp256k1-js/issues"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "./index.js",
    "./index.d.ts",
    "./generate_private_key.js",
    "./generate_private_key.d.ts",
    "./get_public_key.js",
    "./get_public_key.d.ts",
    "./hmac_sha256.js",
    "./hmac_sha256.d.ts",
    "./recover_public_key.js",
    "./recover_public_key.d.ts",
    "./verify.js",
    "./verify.d.ts",
    "./sha256.js",
    "./sha256.d.ts",
    "./sign.js",
    "./sign.d.ts",
    "./utils.js",
    "./utils.d.ts",
    "./SECURITY.md",
    "./docs/randomness.md",
    "./llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./generate_private_key.js": {
      "types": "./generate_private_key.d.ts",
      "import": "./generate_private_key.js",
      "default": "./generate_private_key.js"
    },
    "./generate_private_key": {
      "types": "./generate_private_key.d.ts",
      "import": "./generate_private_key.js",
      "default": "./generate_private_key.js"
    },
    "./get_public_key.js": {
      "types": "./get_public_key.d.ts",
      "import": "./get_public_key.js",
      "default": "./get_public_key.js"
    },
    "./get_public_key": {
      "types": "./get_public_key.d.ts",
      "import": "./get_public_key.js",
      "default": "./get_public_key.js"
    },
    "./hmac_sha256.js": {
      "types": "./hmac_sha256.d.ts",
      "import": "./hmac_sha256.js",
      "default": "./hmac_sha256.js"
    },
    "./hmac_sha256": {
      "types": "./hmac_sha256.d.ts",
      "import": "./hmac_sha256.js",
      "default": "./hmac_sha256.js"
    },
    "./recover_public_key.js": {
      "types": "./recover_public_key.d.ts",
      "import": "./recover_public_key.js",
      "default": "./recover_public_key.js"
    },
    "./recover_public_key": {
      "types": "./recover_public_key.d.ts",
      "import": "./recover_public_key.js",
      "default": "./recover_public_key.js"
    },
    "./verify.js": {
      "types": "./verify.d.ts",
      "import": "./verify.js",
      "default": "./verify.js"
    },
    "./verify": {
      "types": "./verify.d.ts",
      "import": "./verify.js",
      "default": "./verify.js"
    },
    "./sign.js": {
      "types": "./sign.d.ts",
      "import": "./sign.js",
      "default": "./sign.js"
    },
    "./sign": {
      "types": "./sign.d.ts",
      "import": "./sign.js",
      "default": "./sign.js"
    },
    "./utils.js": {
      "types": "./utils.d.ts",
      "import": "./utils.js",
      "default": "./utils.js"
    },
    "./utils": {
      "types": "./utils.d.ts",
      "import": "./utils.js",
      "default": "./utils.js"
    },
    "./sha256": {
      "types": "./sha256.d.ts",
      "import": "./sha256.js",
      "default": "./sha256.js"
    },
    "./sha256.js": {
      "types": "./sha256.d.ts",
      "import": "./sha256.js",
      "default": "./sha256.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test": "npm run format:check && npm run build && npm run typecheck && npm run test:unit",
    "prepack": "npm test",
    "postpack": "npm run clean"
  },
  "homepage": "https://github.com/pur3miish/isomorphic-secp256k1-js#readme",
  "engines": {
    "node": ">= 20.19.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "devDependencies": {
    "@types/node": "26.4.0",
    "esbuild": "0.28.1",
    "prettier": "3.9.6",
    "tsx": "4.23.5",
    "typescript": "5.9.3"
  }
}
